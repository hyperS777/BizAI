%%{init: {'theme': 'base', 'sequence': {'actorMargin': 150, 'messageMargin': 60}}}%%
sequenceDiagram
    autonumber
    actor U as Accountant
    participant FE as React Client
    participant API as FastAPI Gateway
    participant INV as Invoice Service
    participant DB as PostgreSQL Database

    Note over U,DB: PHASE 1: Generate Invoice
    U->>+FE: generateInvoice(orderId)
    FE->>+API: POST /api/invoices
    API->>+INV: create_invoice_from_order(orderId)
    INV->>+DB: SELECT * FROM orders WHERE id = :orderId
    DB-->>-INV: Order Record
    alt Order Not Confirmed or Invoice Exists
        INV-->>API: throw ValidationError()
        API-->>FE: 400 Bad Request
        FE-->>U: showError("Cannot generate invoice")
    else Valid for Invoicing
        INV->>+DB: INSERT INTO invoices (status='Draft')
        DB-->>-INV: Invoice Created ID
        INV-->>-API: return Invoice(Draft)
        API-->>-FE: 201 Created
        FE-->>-U: showInvoicePreview()
    end

    Note over U,DB: PHASE 2: Record Payment
    U->>+FE: recordPayment(invoiceId, amount)
    FE->>+API: PATCH /api/invoices/{id}/payment
    API->>+INV: process_payment(invoiceId, amount)
    INV->>+DB: SELECT total_amount, paid_amount FROM invoices
    DB-->>-INV: Invoice Financials
    
    INV->>INV: calculate_new_balance(amount)
    
    alt Fully Paid
        INV->>+DB: UPDATE invoices SET status = 'Paid'
        DB-->>-INV: Rows Affected
    else Partial Payment
        INV->>+DB: UPDATE invoices SET paid_amount = new_amount, status = 'Sent'
        DB-->>-INV: Rows Affected
    end
    INV-->>-API: return Invoice(Updated)
    API-->>-FE: 200 OK
    FE-->>-U: showUpdatedStatus()
