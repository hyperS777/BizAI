sequenceDiagram
    autonumber
    actor U as Authorised staff user
    participant FE as React Invoices page
    participant API as FastAPI /api/invoices
    participant IS as invoice_service.py
    participant DB as SQLAlchemy database
    U->>FE: generate invoice for order
    FE->>API: POST /api/invoices/from-order/{order_id}
    API->>IS: generate_invoice_from_order(db, order_id)
    IS->>DB: SELECT order and invoice by order_id
    alt order does not exist
        IS-->>API: None
        API-->>FE: 404 Order not found
    else invoice already exists
        IS-->>API: existing invoice
        API-->>FE: 200 invoice response
    else no invoice exists
        IS->>DB: INSERT invoice (status=sent, due_date=+15 days)
        DB-->>IS: saved invoice
        IS-->>API: invoice
        API-->>FE: 200 invoice response
    end
    opt accountant/admin/manager updates amount or status
        U->>FE: update invoice
        FE->>API: PATCH /api/invoices/{invoice_id}/status (InvoiceUpdate JSON)
        API->>IS: update_invoice(db, invoice_id, payload)
        IS->>DB: UPDATE invoice and commit
        API-->>FE: 200 updated invoice
    end
