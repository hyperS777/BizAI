classDiagram
    direction TB

    class AuthService {
        +verify_password(plain, hash) bool
        +create_access_token(email) str
        +get_current_user(token, db) User
    }

    class UserService {
        +get_users(db) List~User~
        +create_user(db, data) User
        +update_user(db, id, data) User
    }

    class CustomerService {
        +get_customers(db, search) List~Customer~
        +create_customer(db, data) Customer
        +update_customer(db, id, data) Customer
    }

    class ProductService {
        +get_products(db) List~Product~
        +create_product(db, data) Product
        +update_stock(db, id, qty, reason) Product
    }

    class OrderService {
        +get_orders(db) List~Order~
        +create_order(db, data, user_id) Order
        +update_order_status(db, id, status) Order
    }

    class InvoiceService {
        +create_invoice(db, order_id) Invoice
        +record_payment(db, id, amount) Invoice
        +generate_pdf(id) bytes
    }

    class ReportService {
        +build_business_snapshot(db) dict
        +get_sales_summary(db) dict
    }

    class AIService {
        +answer_query(db, user, query) AIQuery
        -_fallback_answer(query, snapshot) str
        -_ask_model(query, snapshot) str
    }

    AuthService --> User
    UserService --> User
    CustomerService --> Customer
    ProductService --> Product
    ProductService --> InventoryMovement
    OrderService --> Order
    OrderService --> ProductService : update_stock
    InvoiceService --> Invoice
    ReportService --> Order
    ReportService --> Product
    AIService --> ReportService : snapshot
    AIService --> AIQuery
