---
title: Data Flow Diagram (Level 1) - BizAI
---
%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryBorderColor': '#1155cc', 'lineColor': '#1155cc', 'textColor': '#000000', 'fontFamily': 'sans-serif'}}}%%
flowchart LR
    %% External Entities
    CLIENT["Authenticated Users"]
    AI_PROVIDER["AI Provider Service"]

    %% Data Stores (Cylinders/Open Rectangles)
    D1[("D1: roles and users")]
    D2[("D2: Customers and Catalog DB")]
    D3[("D3: orders and order_items")]
    D4[("D4: Finance DB")]
    D5[("D5: ai_queries")]

    %% Processes (Circles)
    P1("1.0\nAuthenticate\nUser")
    P2("2.0\nManage Customers\nand Catalog")
    P3("3.0\nProcess\nOrders")
    P4("4.0\nManage Invoices\nand Expenses")
    P5("5.0\nGenerate\nReports")
    P6("6.0\nProcess AI\nQueries")

    %% Flows
    CLIENT -- "Credentials" --> P1
    P1 -- "credential lookup" --> D1
    D1 -- "user and role record" --> P1
    P1 -- "Session Token" --> CLIENT

    CLIENT -- "Customer or Catalog Data" --> P2
    P2 -- "Customer or Catalog Updates" --> D2
    D2 -- "Customer or Catalog Data" --> P2
    P2 -- "Customer or Catalog Result" --> CLIENT

    CLIENT -- "Order Details" --> P3
    P3 -- "Product Lookup or Stock Update" --> D2
    D2 -- "Product and Stock Data" --> P3
    P3 -- "Order Data" --> D3
    D3 -- "Saved Order Data" --> P3
    P3 -- "Order Status" --> CLIENT

    CLIENT -- "Invoice Update or\nExpense Record" --> P4
    P4 -- "Financial Data" --> D4
    D4 -- "Invoice/Receipt" --> P4
    P4 -- "Financial Status" --> CLIENT

    CLIENT -- "Report Request" --> P5
    D2 -- "Customer and Inventory Data" --> P5
    D3 -- "Order and Sales Data" --> P5
    D4 -- "Financial Data" --> P5
    P5 -- "Dashboard and Report Data" --> CLIENT

    CLIENT -- "Question" --> P6
    D2 -- "Customer and Inventory Context" --> P6
    D3 -- "Order Context" --> P6
    D4 -- "Financial Context" --> P6
    P6 -- "Business Context and Question" --> AI_PROVIDER
    AI_PROVIDER -- "Generated Answer" --> P6
    P6 -- "Query Log" --> D5
    P6 -- "AI Response" --> CLIENT

    %% Styling
    classDef entityBox fill:#ffffff,stroke:#1155cc,stroke-width:2px,color:#000,;
    classDef processNode fill:#e8f4f8,stroke:#1155cc,stroke-width:2px,color:#000,rx:15,ry:15;
    classDef dataStore fill:#ffffff,stroke:#1155cc,stroke-width:2px,color:#000;
    
    class CLIENT,AI_PROVIDER entityBox;
    class P1,P2,P3,P4,P5,P6 processNode;
    class D1,D2,D3,D4,D5 dataStore;
