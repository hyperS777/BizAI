erDiagram
    roles ||--o{ users : "has"
    users ||--o{ orders : "creates"
    users ||--o{ expenses : "records"
    users ||--o{ ai_queries : "asks"
    users ||--o{ inventory_movements : "performs"
    customers ||--o{ orders : "places"
    categories ||--o{ products : "groups"
    orders ||--|{ order_items : "contains"
    products ||--o{ order_items : "in"
    orders ||--o| invoices : "generates"
    products ||--o{ inventory_movements : "tracks"

    roles {
        int id PK
        string name
        string description
    }

    users {
        int id PK
        string email
        string password_hash
        string full_name
        int role_id FK
        bool is_active
    }

    customers {
        int id PK
        string name
        string email
        string phone
        string company
        float outstanding_balance
    }

    categories {
        int id PK
        string name
    }

    products {
        int id PK
        string name
        string sku
        float price
        float cost_price
        int stock_qty
        int min_stock_level
        int category_id FK
        bool is_active
    }

    orders {
        int id PK
        string order_number
        int customer_id FK
        int created_by FK
        string status
        float total_amount
    }

    order_items {
        int id PK
        int order_id FK
        int product_id FK
        int quantity
        float unit_price
        float total_price
    }

    invoices {
        int id PK
        string invoice_number
        int order_id FK
        string status
        float total_amount
        float paid_amount
        date due_date
    }

    expenses {
        int id PK
        string description
        float amount
        string category
        date date
        int created_by FK
    }

    inventory_movements {
        int id PK
        int product_id FK
        int quantity_change
        string reason
        int created_by FK
    }

    ai_queries {
        int id PK
        int user_id FK
        text query_text
        text response_text
        string intent
    }
