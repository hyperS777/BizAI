classDiagram
 direction LR
 class Role { +id: Integer +name: String +description: String }
 class User { +id: Integer +email: String -password_hash: String +full_name: String +role_id: Integer +is_active: Boolean }
 class Customer { +id: Integer +name: String +email: String +phone: String +address: Text +company: String +gstin: String +outstanding_balance: Float }
 class Category { +id: Integer +name: String +description: String }
 class Product { +id: Integer +name: String +sku: String +description: Text +price: Float +cost_price: Float +stock_qty: Integer +min_stock_level: Integer +category_id: Integer +is_active: Boolean +is_low_stock: bool }
 class Order { +id: Integer +order_number: String +customer_id: Integer +created_by: Integer +status: String +total_amount: Float +notes: Text }
 class OrderItem { +id: Integer +order_id: Integer +product_id: Integer +quantity: Integer +unit_price: Float +total_price: Float }
 class Invoice { +id: Integer +invoice_number: String +order_id: Integer +status: String +total_amount: Float +paid_amount: Float +due_date: Date +balance_due: float +issue_date: DateTime }
 class Expense { +id: Integer +description: String +amount: Float +category: String +date: Date +notes: Text +created_by: Integer }
 class InventoryMovement { +id: Integer +product_id: Integer +quantity_change: Integer +reason: String +notes: Text +created_by: Integer }
 class AIQuery { +id: Integer +user_id: Integer +query_text: Text +response_text: Text +intent: String }
 Role "1" --> "0..*" User : role
 User "1" --> "0..*" Order : created_by_user
 User "1" --> "0..*" Expense : created_by_user
 User "1" --> "0..*" AIQuery : user
 User "0..1" --> "0..*" InventoryMovement : creator
 Customer "1" --> "0..*" Order : customer
 Category "0..1" --> "0..*" Product : category
 Order "1" *-- "1..*" OrderItem : items
 Product "1" --> "0..*" OrderItem : product
 Order "1" --> "0..1" Invoice : invoice
 Product "1" --> "0..*" InventoryMovement : movements
