flowchart TD
    subgraph Presentation_Layer ["Presentation Layer"]
        direction TB
        WEB["React JS + Vite UI\n(Web browser SPA)"]
    end

    subgraph Application_Layer ["Application Layer"]
        direction LR
        ROUTES["API Routers\n(FastAPI)"]
        AUTH["Authentication &\nAuthorization (JWT)"]
        LOGIC["Business Logic\n(Customers, Orders,\nInvoices, Reports)"]
        DATA["SQLAlchemy ORM\nModels"]
        ROUTES --> AUTH --> LOGIC --> DATA
    end

    subgraph Persistence_Layer ["Persistence Layer"]
        direction TB
        DB[("Relational Database\n(SQLite / PostgreSQL)")]
    end

    subgraph External_Layer ["External Layer"]
        direction TB
        AI["AI Provider Service\n(Data-grounded AI assistant)"]
    end

    U["Staff User"] --> WEB
    WEB -->|"REST JSON + Bearer JWT"| ROUTES
    DATA --> DB
    LOGIC --> AI
    
