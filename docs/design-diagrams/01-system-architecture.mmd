%% UML component/deployment view of the BizAI system

flowchart LR
    U["Staff user"] --> WEB["Web browser\nReact + Vite SPA"]

    subgraph APP["BizAI FastAPI application"]
        direction TB
        ROUTES["API routers"]
        AUTH["JWT authentication\nand role permissions"]
        LOGIC["Business modules\ncustomers, products, orders, invoices\nexpenses, reports and AI"]
        DATA["SQLAlchemy ORM models"]
        ROUTES --> AUTH --> LOGIC --> DATA
    end

    WEB -->|"REST JSON + Bearer JWT"| ROUTES
    DATA --> DB[("Relational database\nSQLite by default")]
    LOGIC --> AI["Data-grounded AI assistant\nprovider selected by configuration"]
