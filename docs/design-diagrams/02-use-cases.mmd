%% UML use-case model: associations connect actors to individual use cases, never to packages.
flowchart LR
  A["Admin"]
  M["Manager"]
  E["Employee"]
  AC["Accountant"]
  subgraph S["BizAI system boundary"]
    L(["Sign in"])
    CU(["Manage users"])
    CC(["Manage customers"])
    CP(["Manage products and categories"])
    AS(["Adjust stock"])
    CO(["Create order"])
    US(["Change order status"])
    GI(["Generate invoice from order"])
    UI(["Update invoice / record payment"])
    PDF(["Download invoice PDF"])
    EX(["Manage expenses"])
    R(["View dashboard and reports"])
    AI(["Ask AI assistant"])
    LOG(["Record inventory movement"])
    SNAP(["Build business snapshot"])
  end
  A --- L & CU & CC & CP & AS & CO & US & GI & UI & PDF & EX & R & AI
  M --- L & CC & CP & AS & CO & US & GI & UI & PDF & EX & R & AI
  E --- L & CC & CO & R & AI
  AC --- L & GI & UI & PDF & EX & R & AI
  AS -. "«include»" .-> LOG
  US -. "«include»" .-> LOG
  AI -. "«include»" .-> SNAP
  %% Guard: US includes LOG only on confirmation or cancellation status changes
