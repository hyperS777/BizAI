%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryBorderColor': '#1155cc', 'lineColor': '#1155cc', 'textColor': '#000000', 'fontFamily': 'sans-serif', 'actorBkg': '#e8f4f8', 'actorBorder': '#1155cc', 'signalColor': '#333333', 'signalTextColor': '#333333'}}}%%
sequenceDiagram
    autonumber
    actor U as Staff user
    participant FE as React Login page
    participant API as FastAPI /api/auth
    participant DB as SQLAlchemy database
    U->>FE: enter email and password
    FE->>API: POST /api/auth/login (OAuth2 form: username, password)
    API->>DB: find User by email
    DB-->>API: User record or none
    alt no user, invalid password, or inactive user
        API-->>FE: 401 Unauthorized or 400 Inactive user
        FE-->>U: show authentication error
    else authenticated
        API->>API: verify password and create signed JWT
        API-->>FE: 200 {access_token, token_type}
        FE->>FE: store token in localStorage
        FE->>API: GET /api/auth/me (Authorization: Bearer JWT)
        API->>API: validate JWT and active user dependency
        API-->>FE: 200 UserResponse
        FE-->>U: navigate to dashboard
    end
