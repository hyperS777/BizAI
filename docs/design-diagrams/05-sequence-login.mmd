%%{init: {'theme': 'base', 'sequence': {'actorMargin': 150, 'messageMargin': 60}}}%%
sequenceDiagram
    autonumber
    actor U as User
    participant FE as React Client (SPA)
    participant API as FastAPI Gateway
    participant AUTH as Auth Service
    participant DB as PostgreSQL Database

    U->>+FE: enterCredentials(email, password)
    FE->>+API: POST /api/auth/login
    API->>+AUTH: authenticate_user(email, password)
    AUTH->>+DB: SELECT * FROM users WHERE email = :email
    DB-->>-AUTH: return User Record
    
    alt User Not Found or Invalid Password
        AUTH-->>API: throw UnauthorizedError()
        API-->>FE: 401 Unauthorized
        FE-->>U: displayError("Invalid credentials")
    else Valid Credentials
        AUTH->>AUTH: verify_password(plain, hash)
        AUTH->>AUTH: create_access_token(email)
        AUTH-->>-API: return Token(access_token)
        API-->>-FE: 200 OK (access_token)
        
        FE->>+API: GET /api/auth/me (Bearer Token)
        API->>+AUTH: get_current_user(token)
        AUTH->>+DB: SELECT user, role WHERE email = token.sub
        DB-->>-AUTH: return User & Role Profile
        AUTH-->>-API: return UserProfile
        API-->>-FE: 200 OK (UserProfile)
        FE-->>-U: redirect(Dashboard)
    end
