%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryBorderColor': '#1155cc', 'lineColor': '#1155cc', 'textColor': '#000000', 'fontFamily': 'sans-serif'}}}%%
flowchart LR
    %% External Entities (Rectangles)
    ADMIN["Administrator"]
    MGR["Manager"]
    EMP["Employee"]
    ACC["Accountant"]

    %% System Process (Rounded Rectangle to match reference)
    SYS("0.0\nBizAI\nInformation\nSystem")

    %% External Systems (Rectangles)
    AI_PROVIDER["AI Provider Service"]

    %% Data Flows
    ADMIN -- "Configuration Data,\nUser Credentials" --> SYS
    SYS -- "User-Management Results,\nSystem Status" --> ADMIN

    MGR -- "Operational Requests,\nBusiness Queries" --> SYS
    SYS -- "AI Insights,\nAggregated Reports" --> MGR

    EMP -- "Customer and\nOrder Details" --> SYS
    SYS -- "Customer and\nOrder Results" --> EMP

    ACC -- "Payment Entries,\nExpense Records" --> SYS
    SYS -- "Financial Summaries,\nInvoices" --> ACC

    SYS -- "Business Context,\nNatural Language Query" --> AI_PROVIDER
    AI_PROVIDER -- "AI Generated Response" --> SYS

    %% Styling
    classDef entityBox fill:#ffffff,stroke:#1155cc,stroke-width:2px,color:#000;
    classDef processNode fill:#e8f4f8,stroke:#1155cc,stroke-width:2px,color:#000,rx:15,ry:15;
    
    class ADMIN,MGR,EMP,ACC,AI_PROVIDER entityBox;
    class SYS processNode;
