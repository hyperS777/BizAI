%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryBorderColor': '#1155cc', 'lineColor': '#1155cc', 'textColor': '#000000', 'fontFamily': 'sans-serif', 'actorBkg': '#e8f4f8', 'actorBorder': '#1155cc', 'signalColor': '#333333', 'signalTextColor': '#333333'}}}%%
sequenceDiagram
    autonumber
    actor U as Admin or Manager
    participant FE as React Inventory page
    participant API as FastAPI /api/products
    participant PS as product_service.py
    participant DB as SQLAlchemy database
    U->>FE: enter quantity change, reason and notes
    FE->>API: POST /api/products/{product_id}/stock (StockAdjust JSON)
    API->>PS: update_stock(db, product_id, quantity_change, reason, notes, user_id)
    PS->>DB: SELECT product by id
    alt product missing
        PS-->>API: None
        API-->>FE: 404 Product not found
    else negative resulting stock
        PS-->>API: ValueError
        API-->>FE: 400 error
    else valid change
        PS->>DB: UPDATE products stock_qty
        PS->>DB: INSERT inventory_movements
        PS->>DB: COMMIT
        API-->>FE: 200 updated product
        FE-->>U: show new stock level
    end
