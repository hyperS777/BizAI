# BizAI Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./bizai.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/bizai?sslmode=require

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key

# Shopify Admin API. Create a custom app with read_products, read_inventory,
# read_customers, read_orders, and write_orders scopes. Historical orders older than 60 days
# may also require Shopify's read_all_orders approval.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
DELIVERY_WEBHOOK_SECRET=
# Public API origin used to create customer invoice links, e.g. https://api.example.com
PUBLIC_API_BASE_URL=
STOREFRONT_SIMULATION_ENABLED=true
# Configure webhooks to POST to https://<your-api>/api/integrations/shopify/webhooks:
# products/create, products/update, products/delete, customers/create,
# customers/update, orders/create, orders/updated, orders/cancelled,
# fulfillments/create, fulfillments/update, inventory_levels/update, refunds/create
# Configure the courier provider to POST location updates to
# https://<your-api>/api/integrations/delivery/location, with X-Delivery-Event-Id
# and X-BizAI-Signature (base64 HMAC-SHA256 over the raw JSON body).

# App
APP_NAME=BizAI
DEBUG=true
# Include the deployed Vercel frontend origin in production, e.g.
# CORS_ORIGINS=https://your-project.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
